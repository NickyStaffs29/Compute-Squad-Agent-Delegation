#!/bin/sh
# Stand-in for codex in scripts/verify.sh check 8e. `codex debug models`
# prints the model catalog in the file STUB_CATALOG names; every other call
# does nothing and exits 0. When STUB_LOG is set, it appends one line per
# call to that file: the name it was called by, then its arguments.
if [ -n "${STUB_LOG:-}" ]; then
  printf '%s %s\n' "${0##*/}" "$*" >> "$STUB_LOG"
fi
if [ "${1:-}" = debug ] && [ "${2:-}" = models ]; then
  exec cat "${STUB_CATALOG:?STUB_CATALOG names no catalog file}"
fi
exit 0
