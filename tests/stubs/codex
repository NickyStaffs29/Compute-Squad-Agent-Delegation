#!/bin/sh
# Stand-in for codex and git in scripts/verify.sh check 8e; it acts as the
# command it was called as. When STUB_LOG is set, every call appends one line
# to that file: the name it was called by, then its arguments.
#
# As git (after -C DIR and --no-optional-locks): `status --porcelain` prints
# STUB_GIT_STATUS (empty means clean); `ls-files` runs the real git named by
# STUB_REAL_GIT; `rev-parse` answers from STUB_GIT_BRANCH (default main),
# STUB_GIT_UPSTREAM (default origin/main; set it empty for no upstream),
# STUB_GIT_HEAD (default forty 1s), and STUB_GIT_UPSTREAM_HEAD (default
# STUB_GIT_HEAD); every other call, pull included, does nothing and exits 0.
#
# As codex: `debug models` prints the catalog file STUB_CATALOG names. The
# plugin commands keep their state under STUB_STATE, outside CODEX_HOME:
# `plugin marketplace add DIR` records DIR under the name its
# .agents/plugins/marketplace.json gives, and refuses a name already added
# from another directory, as Codex 0.157.0 does; `plugin add PLUGIN@MARKET` copies
# that marketplace's plugins/PLUGIN into
# $CODEX_HOME/plugins/cache/MARKET/PLUGIN/VERSION, replacing what was there,
# as Codex 0.157.0 does (when STUB_PAUSE_DIR is set, it first creates
# $STUB_PAUSE_DIR/paused and waits until $STUB_PAUSE_DIR/go exists, so a test
# can hold an update mid-install; when STUB_CORRUPT_INSTALL is set, it then
# appends a line to the cached skill's references/resume.md, so the install
# lands content the source does not have); `plugin list --json` prints the installed plugins in
# Codex's shape, with each local plugin's source path, or fails when
# STUB_FAIL_PLUGIN_LIST is set, as Codex does
# when any configured marketplace cannot load; `plugin remove PLUGIN@MARKET`
# deletes the plugin and its cache. Every other call does nothing and exits 0.
if [ -n "${STUB_LOG:-}" ]; then
  printf '%s %s\n' "${0##*/}" "$*" >> "$STUB_LOG"
fi

if [ "${0##*/}" = git ]; then
  command=""
  skip=0
  for arg in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$arg" in
      -C) skip=1 ;;
      --no-optional-locks) ;;
      *) command="$arg"; break ;;
    esac
  done
  head="${STUB_GIT_HEAD:-1111111111111111111111111111111111111111}"
  case "$command" in
    status) printf '%s' "${STUB_GIT_STATUS:-}" ;;
    ls-files) exec "${STUB_REAL_GIT:?STUB_REAL_GIT names no git}" "$@" ;;
    rev-parse)
      case "$*" in
        *"--symbolic-full-name @{upstream}"*)
          upstream="${STUB_GIT_UPSTREAM-origin/main}"
          [ -n "$upstream" ] || { echo "fatal: no upstream configured for branch" >&2; exit 128; }
          echo "$upstream"
          ;;
        *"--abbrev-ref HEAD"*) echo "${STUB_GIT_BRANCH:-main}" ;;
        *"@{upstream}"*) echo "${STUB_GIT_UPSTREAM_HEAD:-$head}" ;;
        *HEAD*) echo "$head" ;;
      esac
      ;;
  esac
  exit 0
fi

state="${STUB_STATE:-}"
case "${1:-} ${2:-} ${3:-}" in
  "debug models "*)
    exec cat "${STUB_CATALOG:?STUB_CATALOG names no catalog file}"
    ;;
  "plugin marketplace add")
    dir="$4"
    name="$(sed -n 's/^  "name": "\(.*\)",$/\1/p' "$dir/.agents/plugins/marketplace.json" | head -n 1)"
    [ -n "$name" ] || { echo "stub codex: no marketplace name in $dir" >&2; exit 1; }
    mkdir -p "${state:?STUB_STATE names no directory}/marketplaces"
    if [ -f "$state/marketplaces/$name" ] && [ "$(cat "$state/marketplaces/$name")" != "$dir" ]; then
      echo "stub codex: marketplace '$name' is already added from a different source" >&2
      exit 1
    fi
    printf '%s\n' "$dir" > "$state/marketplaces/$name"
    ;;
  "plugin add "*)
    if [ -n "${STUB_PAUSE_DIR:-}" ]; then
      : > "$STUB_PAUSE_DIR/paused"
      waited=0
      until [ -e "$STUB_PAUSE_DIR/go" ]; do
        waited=$((waited + 1))
        [ "$waited" -le 1200 ] || { echo "stub codex: $STUB_PAUSE_DIR/go never appeared" >&2; exit 1; }
        sleep 0.1
      done
    fi
    plugin="${3%@*}"
    market="${3#*@}"
    root="$(cat "${state:?STUB_STATE names no directory}/marketplaces/$market" 2>/dev/null)" \
      || { echo "stub codex: no marketplace $market" >&2; exit 1; }
    source="$root/plugins/$plugin"
    version="$(sed -n 's/^  "version": "\(.*\)",$/\1/p' "$source/.codex-plugin/plugin.json")"
    cache="${CODEX_HOME:?CODEX_HOME is not set}/plugins/cache/$market/$plugin/$version"
    rm -rf "$cache"
    mkdir -p "$cache" "$state/installed"
    cp -R "$source/." "$cache/"
    if [ -n "${STUB_CORRUPT_INSTALL:-}" ]; then
      echo "stale line from a broken install" >> "$cache/skills/compute-squad/references/resume.md"
    fi
    printf '%s\n' "$version" > "$state/installed/$3"
    ;;
  "plugin list --json")
    if [ -n "${STUB_FAIL_PLUGIN_LIST:-}" ]; then
      echo "Error: failed to load configured marketplace snapshot(s)" >&2
      exit 1
    fi
    printf '{"installed": ['
    sep=""
    for f in "${state:?STUB_STATE names no directory}"/installed/*; do
      [ -e "$f" ] || continue
      id="${f##*/}"
      source=""
      if [ -f "$state/marketplaces/${id#*@}" ]; then
        source="$(printf ', "source": {"source": "local", "path": "%s/plugins/%s"}' \
          "$(cat "$state/marketplaces/${id#*@}")" "${id%@*}")"
      fi
      printf '%s{"pluginId": "%s", "name": "%s", "marketplaceName": "%s", "version": "%s", "installed": true, "enabled": true%s}' \
        "$sep" "$id" "${id%@*}" "${id#*@}" "$(cat "$f")" "$source"
      sep=", "
    done
    printf '], "available": []}\n'
    ;;
  "plugin remove "*)
    rm -f "${state:?STUB_STATE names no directory}/installed/$3"
    rm -rf "${CODEX_HOME:?CODEX_HOME is not set}/plugins/cache/${3#*@}/${3%@*}"
    ;;
esac
exit 0
