+
+test('a second request within 60 seconds sends no email and creates no token', async () => {
+  const { app, clock, reset } = setup();
+  const first = reset('ada@example.com');
+  clock.advance(59 * 1000);
+  await new Promise((resolve) => setTimeout(resolve, 5));
+  const second = reset('ada@example.com');
+  console.log(second.body);
+  assert.equal(second.status, first.status);
+  assert.equal(app.outbox.length, 1);
+});
+
+test('a request 60 seconds after the last token creates a token and sends the email', () => {
+  const { app, clock, reset } = setup();
+  reset('ada@example.com');
+  clock.advance(61 * 1000);
+  reset('ada@example.com');
+  assert.equal(app.outbox.length, 2);
+});
+
+test.skip('a cooldown hit logs reset_cooldown_hit', () => {});
