+
+test('a send, a refusal inside the cooldown, and an unknown address log the same single event', () => {
+  const { app, clock, reset } = setup();
+  const logged = (email) => {
+    const before = app.log.events.length;
+    reset(email);
+    return app.log.events.slice(before);
+  };
+  const event = [{ code: 'reset_request_received' }];
+  assert.deepEqual(logged('ada@example.com'), event);
+  clock.advance(1000);
+  assert.deepEqual(logged('ada@example.com'), event);
+  assert.deepEqual(logged('nobody@example.com'), event);
+  assert.equal(app.outbox.length, 1);
+});
