+++ b/test/page.test.js
@@ -0,0 +1,12 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const page = fs.readFileSync(path.join(__dirname, '..', 'public', 'index.html'), 'utf8');
+
+test('the billing note sits directly under the plans table', () => {
+  const note = '<p class="billing-note">Prices are per month, billed annually. Cancel any time.</p>';
+  assert.match(page, /<\/table>\s*<p class="billing-note">/);
+  assert.ok(page.includes(note));
+});
