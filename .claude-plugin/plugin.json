{
  "name": "compute-squad",
  "version": "4.7.0",
  "description": "Compute Squad runs a staged, auditable coding workflow in Claude Code and Codex. Before every run or resume, you choose and confirm exact models for the top, mid, and bottom tiers; the same model can fill several. Agents map, plan, execute, and adversarially review the work.",
  "author": {
    "name": "Nick Stafford"
  },
  "homepage": "https://github.com/NickyStaffs29/Compute-Squad-Agent-Delegation",
  "repository": "https://github.com/NickyStaffs29/Compute-Squad-Agent-Delegation",
  "license": "MIT",
  "keywords": ["agents", "delegation", "orchestration", "pipeline", "code-quality", "codex"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/compute-squad/hooks/grant-gate.sh\"" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/compute-squad/hooks/usage-ledger.sh\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/compute-squad/hooks/usage-ledger.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
